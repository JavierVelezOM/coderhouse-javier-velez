    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  JSON.stringify({\n    contents: [\n      {\n        parts: [\n          {\n            text: `Eres el Supervisor Al-as-a-Judge de Viajes Laguna. Tu misión es auditar de forma implacable la propuesta del agente antes de tocar el CRM o hablar con el cliente.\n\nCRITERIOS DE AUDITORÍA (Rango 1 a 5):\n1. exactitud_factual: ¿Cada dato numérico o de destino está en las fuentes sin alucinación?\n2. apego_politicas: ¿Cumple con las penalizaciones y plazos oficiales?\n3. fidelidad_citas: ¿Cita con metadatos reales o inventó referencias?\n\nREGLA DE BLOQUEO:\nSi exactitud_factual < 4 o apego_politicas < 4, el estado DEBE ser 'RECHAZADO_HITL'.\n\nFORMATO DE SALIDA (JSON ÚNICAMENTE):\n{\n  \"exactitud_factual\": 5,\n  \"apego_politicas\": 5,\n  \"fidelidad_citas\": 5,\n  \"score_promedio\": 5.0,\n  \"dictamen\": \"APROBADO\",\n  \"justificacion_auditoria\": \"Explicación analítica del veredicto...\"\n}\n\nCONSULTA ORIGINAL:\n$json.chatInput\n\nPROPUESTA EVALUADA:\n$json.propuestaRespuesta`\n          }\n        ]\n      }\n    ],\n    generationConfig: {\n      temperature: 0.0,\n      responseMimeType: \"application/json\"\n    }\n  })\n}}",
        "options": {}
      },
      "id": "a6dadc8d-ae89-48c7-b964-4d19fa7ab8be",
      "name": "Gemini: AI-as-a-Judge QA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -608,
        -80
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "vNEKkWwhHQs0axth",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "let judgeRubric = {};\ntry {\n  const rawText = $input.first().json.candidates[0].content.parts[0].text\n  judgeRubric = JSON.parse(rawText);\n} catch (e) {\n  judgeRubric = {\n    exactitud_factual: 1,\n    apego_politicas: 1,\n    fidelidad_citas: 1,\n    score_promedio: 1.0,\n    dictamen: 'RECHAZADO_HITL',\n    justificacion_auditoria: 'Fallo al parsear rúbrica de auditoría. Se bloquea autonomía por seguridad.'\n  };\n}\n\nconst prevData = $('When Executed by Another Workflow').first().json;\nconst isApproved = judgeRubric.exactitud_factual >= 4 && judgeRubric.dictamen === 'APROBADO';\n\nreturn [{\n  json: {\n    ...prevData,\n    auditoriaJuez: judgeRubric,\n    isApproved\n  }\n}];"
      },
